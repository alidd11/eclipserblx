# Discord
DISCORD_CUSTOMER_BOT_TOKEN=your_bot_token
DISCORD_GUILD_ID=your_main_guild_id

# Role IDs (main Eclipse server)
DISCORD_CUSTOMER_ROLE_ID=
DISCORD_LOYAL_CUSTOMER_ROLE_ID=
DISCORD_STORE_CREATOR_ROLE_ID=
DISCORD_VERIFIED_SELLER_ROLE_ID=

# Backend — the bot does NOT use a Supabase service_role key (it is not available
# on Lovable Cloud). All privileged DB work goes through the bot-gateway edge
# function; the bot authenticates to it with the shared secret below.
SUPABASE_URL=https://qlnbergwjfrmgkjhrbkj.supabase.co
# Generate any strong random string (e.g. `openssl rand -hex 32`). The SAME value
# must be set as a Cloud secret named BOT_GATEWAY_SECRET in Lovable.
BOT_GATEWAY_SECRET=

# Optional
DISCORD_WEBHOOK_URL=
SITE_URL=https://eclipserblx.com

# Orion outbound webhook (member_join / member_leave forwarding) — optional.
# The SAME DISCORD_WEBHOOK_SECRET must be configured on the receiving Orion app.
# Leave ORION_WEBHOOK_URL blank to use the bot's built-in default.
ORION_WEBHOOK_URL=
DISCORD_WEBHOOK_SECRET=
